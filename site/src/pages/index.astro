---
// 《白话 FDE》首页：直接展示内容 —— 前言 + 8 篇 31 章直达（按篇分组），无版本选择
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { config } from "virtual:nimbus/config";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

// Prerender explicitly so the homepage stays a static route under
// `output: "server"` — an adapter alone must add zero on-demand routes.
export const prerender = true;

const base = import.meta.env.BASE_URL;

const preface = { slug: "preface", title: "前言：模型已经够强了，为什么 AI 还是落不了地" };

const parts = [
  {
    label: "第一篇 先说清：FDE 到底是什么",
    chapters: [
      { slug: "part1/ch01", title: "第 1 章 不是驻场外包" },
      { slug: "part1/ch02", title: "第 2 章 一张岗位地图" },
      { slug: "part1/ch03", title: "第 3 章 Palantir 发明了什么" },
    ],
  },
  {
    label: "第二篇 为什么偏偏是现在爆发",
    chapters: [
      { slug: "part2/ch04", title: "第 4 章 AI 的最后一公里" },
      { slug: "part2/ch05", title: "第 5 章 2026 大厂军备竞赛" },
      { slug: "part2/ch06", title: "第 6 章 钱与人" },
      { slug: "part2/ch07", title: "第 7 章 中国语境" },
    ],
  },
  {
    label: "第三篇 一个项目是怎么跑完的",
    chapters: [
      { slug: "part3/ch08", title: "第 8 章 入场 72 小时" },
      { slug: "part3/ch09", title: "第 9 章 把含糊问题拆成目标" },
      { slug: "part3/ch10", title: "第 10 章 两周出第一版" },
      { slug: "part3/ch11", title: "第 11 章 撤场与留守物" },
    ],
  },
  {
    label: "第四篇 FDE 的功夫清单",
    chapters: [
      { slug: "part4/ch12", title: "第 12 章 技术底盘" },
      { slug: "part4/ch13", title: "第 13 章 业务嗅觉" },
      { slug: "part4/ch14", title: "第 14 章 现场能力" },
      { slug: "part4/ch15", title: "第 15 章 小队编制" },
    ],
  },
  {
    label: "第五篇 把现场变成产品：组织与商业",
    chapters: [
      { slug: "part5/ch16", title: "第 16 章 现场变产品" },
      { slug: "part5/ch17", title: "第 17 章 怎么收费" },
      { slug: "part5/ch18", title: "第 18 章 该不该建队" },
      { slug: "part5/ch19", title: "第 19 章 买方指南" },
    ],
  },
  {
    label: "第六篇 企业内部成立 FDE：方法论",
    chapters: [
      { slug: "part6/ch20", title: "第 20 章 自建还是外购" },
      { slug: "part6/ch21", title: "第 21 章 组织设计：放在哪里" },
      { slug: "part6/ch22", title: "第 22 章 组队与选人" },
      { slug: "part6/ch23", title: "第 23 章 运转方法论：四个关口" },
      { slug: "part6/ch24", title: "第 24 章 沉淀与度量" },
    ],
  },
  {
    label: "第七篇 争议与未来",
    chapters: [
      { slug: "part7/ch25", title: "第 25 章 是不是换皮" },
      { slug: "part7/ch26", title: "第 26 章 风险清单" },
      { slug: "part7/ch27", title: "第 27 章 会被 Agent 吃掉吗" },
    ],
  },
  {
    label: "第八篇 入行手册",
    chapters: [
      { slug: "part8/ch28", title: "第 28 章 谁适合，谁别来" },
      { slug: "part8/ch29", title: "第 29 章 面试拆解" },
      { slug: "part8/ch30", title: "第 30 章 90 天转型计划" },
      { slug: "part8/ch31", title: "第 31 章 去哪投，投哪种" },
    ],
  },
];
---

<BaseLayout title={config.title} description={config.description}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-4xl w-full px-6 py-16">
      <h1
        class="text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        {config.title}
      </h1>
      <p class="mt-3 text-[1.0625rem] text-muted-foreground leading-relaxed">
        {config.description}
      </p>
      <p class="mt-2 text-sm text-muted-foreground">
        著 Tony Wu
      </p>
      <p class="mt-4 text-muted-foreground leading-relaxed">
        模型已经够强了，AI 项目却还是一个接一个停在演示阶段，差的就是最后一公里。这本书用大白话
        讲清 FDE（前线部署工程师）这个岗位：它是什么、为什么 2026 年大厂集体下注、一个项目怎么跑完、
        企业内部怎么建队、个人怎么入行。全书跟着一个贯穿案例走：工程师陆远被派到制造企业临江精工，
        把一个停在演示阶段的 AI 项目在 45 天里推上真实产线。
      </p>

      <h2 class="mt-12 text-foreground" style="font-size: var(--nb-h2-size); font-weight: var(--nb-h2-weight);">
        开篇
      </h2>
      <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <a
          href={withBase(`${preface.slug}/`, base)}
          class="block rounded-lg border border-border p-5 transition-colors hover:border-border-strong no-underline"
        >
          <div class="font-medium text-foreground">{preface.title}</div>
        </a>
      </div>

      {parts.map((part) => (
        <>
          <h2 class="mt-12 text-foreground" style="font-size: var(--nb-h2-size); font-weight: var(--nb-h2-weight);">
            {part.label}
          </h2>
          <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
            {part.chapters.map((c) => (
              <a
                href={withBase(`${c.slug}/`, base)}
                class="block rounded-lg border border-border p-5 transition-colors hover:border-border-strong no-underline"
              >
                <div class="font-medium text-foreground">{c.title}</div>
              </a>
            ))}
          </div>
        </>
      ))}
    </main>
  </div>
</BaseLayout>
